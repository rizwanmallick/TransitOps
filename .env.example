# TransitOps Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/transitops?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/transitops?schema=public"

# NextAuth secret (generate a random string for production)
AUTH_SECRET="transitops-hackathon-secret-2026"

# Next.js auth URL
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Business Configuration
# Average rate per km for revenue calculation (INR)
AVG_RATE_PER_KM=15
